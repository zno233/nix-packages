#!/usr/bin/env python3
"""Declarative pin refreshes for packages nix-update cannot drive.

`tools/update-pins.toml` describes, per package, where version and hash data
live and which lines of the package file hold them.  A rule is evaluated in
declaration order: every spec contributes one value to the rule's namespace,
and pins are rewritten only after all of them resolved.

Specs:
  fetch   url = <template> (+ json, json_path)   — document, or scalar value
          prefetch = <template> (+ json_path)    — `nix flake prefetch --json`
          github = <owner/repo> (+ tag)          — a GitHub release; exposes
                                                   {key.tag} and {key.version};
                                                   `tag` selects from the
                                                   release list instead of
                                                   taking the latest release
  derive  doc = <key> + json_path | regex | digest_of
          — a value from a fetched document; digest_of reads the sha256 that
            GitHub records for a named release asset
  pin     pattern = <regex> + value = <template>
          — capture the current value, then rewrite it

`validate` (fullmatch) and `transform` (sri | dmghash | short | iso) apply to
fetched and derived scalars; `validate` on a pin checks the captured value.
Templates resolve flat keys first and then dotted paths into fetched
documents; in regex templates an unresolvable token stays literal, so
quantifiers such as {64} survive.  Pins capture their old value under
`old.<key>` before anything is written.

A rule may also set `diff` and `changelog` templates.  They are rendered like
`commit` (with the same namespace, including `old.*`) and appended to the
commit message as the conventional `Diff:` / `Changelog:` trailers, so
recipes produce the same shape nix-update writes for its packages.

Usage: tools/update-pins [--print-config] [rule ...]   (default: every rule)
"""

import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import tomllib
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RULES_FILE = ROOT / "tools" / "update-pins.toml"

TOKEN = re.compile(r"\{([\w.-]+)(?::(\w+))?\}")
RELEASE_VERSION = re.compile(r"[0-9][0-9A-Za-z.+-]*")

META = ("package", "packages", "commit", "diff", "changelog")

# `validate` / `transform` are accepted wherever a value is produced.
SCALAR = {"validate", "transform"}
FIELDS = {
    "fetch": {"url", "prefetch", "github", "json", "json_path", "tag"} | SCALAR,
    "derive": {"doc", "json_path", "regex", "digest_of"} | SCALAR,
    "pin": {"pattern", "value", "validate"},
}


def log(message: str) -> None:
    print(message, flush=True)


def fail(message: str) -> None:
    raise RuntimeError(message)


def fetch(url: str, retries: int = 5) -> bytes:
    """curl, not urllib: some bot-aware CDNs reset Python's TLS handshakes."""
    last = None
    for _ in range(retries):
        res = subprocess.run(
            [
                "curl",
                "-fsSL",
                "--connect-timeout",
                "30",
                "-A",
                "nix-packages/update-pins",
                *github_auth(url),
                url,
            ],
            capture_output=True,
        )
        if res.returncode == 0:
            return res.stdout
        last = res.stderr.decode(errors="replace")[-300:]
        if b"error: 403" in res.stderr:
            if url.startswith("https://api.github.com/"):
                fail(
                    f"could not fetch {url}: {last.strip()}"
                    " (GitHub API rate limit; export GH_TOKEN to authenticate)"
                )
            break
    fail(f"could not fetch {url}: {last}")


def github_auth(url: str) -> list[str]:
    """curl args authenticating api.github.com when a token is available.

    The unauthenticated API allows 60 requests per hour per IP, and CI
    runners share theirs, so GH_TOKEN/GITHUB_TOKEN is forwarded when set.
    """
    if not url.startswith("https://api.github.com/"):
        return []
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    return ["-H", f"Authorization: Bearer {token}"] if token else []


def sri(hex_digest: str) -> str:
    return subprocess.run(
        ["nix", "hash", "to-sri", "--type", "sha256", hex_digest],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()


class Hasher:
    """dmghash: download a URL once into a temp file (with retries), hash it."""

    def __init__(self) -> None:
        self.cache: dict[str, str] = {}

    def sri_of(self, url: str) -> str:
        if url in self.cache:
            return self.cache[url]
        with tempfile.NamedTemporaryFile() as tmp:
            ok = False
            for _ in range(5):
                if (
                    subprocess.run(
                        ["curl", "-fsSL", "--connect-timeout", "30", "-o", tmp.name, url],
                        capture_output=True,
                    ).returncode
                    == 0
                ):
                    ok = True
                    break
            if not ok:
                fail(f"download failed after retries: {url}")
            digest = hashlib.sha256(tmp.read()).hexdigest()
        if not re.fullmatch(r"[0-9a-f]{64}", digest):
            fail(f"bad sha256 for {url}")
        self.cache[url] = sri(digest)
        return self.cache[url]


def iso_to_date(value: str) -> str:
    stamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
    return stamp.astimezone(timezone.utc).strftime("%Y-%m-%d")


TRANSFORMS = {
    "sri": lambda v, h: sri(v)
    if re.fullmatch(r"[0-9a-f]{64}", v)
    else fail(f"not a sha256 hex: {v}"),
    "dmghash": lambda v, h: h.sri_of(v),
    "short": lambda v, h: v[:7],
    "iso": lambda v, h: iso_to_date(v),
}


def json_path(node, path: str):
    for part in path.split("."):
        node = node[int(part)] if re.fullmatch(r"\d+", part) else node[part]
    return node


def resolve(namespace: dict, name: str):
    """Flat keys first, then dotted paths into documents."""
    if name in namespace:
        return namespace[name]
    parts = name.split(".")
    for cut in range(len(parts) - 1, 0, -1):
        key = ".".join(parts[:cut])
        if key not in namespace:
            continue
        node = namespace[key]
        for part in parts[cut:]:
            node = node[int(part)] if part.isdigit() else node[part]
        return node
    raise KeyError(name)


def render(template: str, namespace: dict, hasher: Hasher, lenient: bool = False) -> str:
    def token(match: re.Match) -> str:
        key, kind = match.group(1), match.group(2)
        try:
            value = resolve(namespace, key)
        except (KeyError, TypeError):
            if lenient:
                # regex templates: braces that are not a reachable value (e.g.
                # {64} quantifiers) stay literal
                return match.group(0)
            fail(f"unknown template value: {match.group(0)}")
        if kind:
            if kind not in TRANSFORMS:
                fail(f"unknown transform: {kind}")
            value = TRANSFORMS[kind](value, hasher)
        return str(value)

    return TOKEN.sub(token, template)


def check(spec: dict, key: str, value: str, hasher: Hasher) -> str:
    """validate + transform a fresh value into its final namespace form."""
    validate = spec.get("validate")
    if validate and not re.fullmatch(validate, value):
        fail(f"{key} failed validation: {value}")
    trans = spec.get("transform")
    if trans:
        if trans not in TRANSFORMS:
            fail(f"unknown transform: {trans}")
        value = TRANSFORMS[trans](value, hasher)
    return value


def release_doc(release: dict) -> dict:
    """Annotate a GitHub release with the tag and the version without its v."""
    tag = str(release.get("tag_name", ""))
    version = tag[1:] if tag.startswith("v") else tag
    if not RELEASE_VERSION.fullmatch(version):
        fail(f"unusable release tag: {tag!r}")
    return {**release, "tag": tag, "version": version}


def spec_kind(name: str, spec: dict) -> str:
    if "pattern" in spec:
        kind = "pin"
    elif "doc" in spec:
        kind = "derive"
    elif {"url", "prefetch", "github"} & set(spec):
        kind = "fetch"
    else:
        fail(f"{name}: unusable spec")

    unknown = set(spec) - FIELDS[kind]
    if unknown:
        fail(f"{name}: unknown field(s) for {kind}: {', '.join(sorted(unknown))}")

    if kind == "fetch":
        sources = {"url", "prefetch", "github"} & set(spec)
        if len(sources) != 1:
            fail(f"{name}: fetch needs exactly one of url, prefetch, github")
        if "json" in spec and "url" not in spec:
            fail(f"{name}: json only applies to url fetches")
        if "tag" in spec and "github" not in spec:
            fail(f"{name}: tag only applies to github fetches")
    elif kind == "derive":
        extractors = {"json_path", "regex", "digest_of"} & set(spec)
        if len(extractors) != 1:
            fail(f"{name}: derive needs exactly one of json_path, regex, digest_of")
    elif kind == "pin":
        if not {"pattern", "value"} <= set(spec):
            fail(f"{name}: pin needs pattern and value")
    return kind


class Rule:
    def __init__(self, name: str, table: dict, hasher: Hasher) -> None:
        self.name = name
        self.table = table
        self.hasher = hasher

    def files(self) -> list[str]:
        if "package" in self.table:
            return [str(ROOT / self.table["package"])]
        return sorted(glob.glob(str(ROOT / self.table["packages"])))

    def fetch_spec(self, key: str, spec: dict, namespace: dict):
        if "github" in spec:
            repo = spec["github"]
            if "tag" in spec:
                releases = json.loads(
                    fetch(f"https://api.github.com/repos/{repo}/releases?per_page=100")
                )
                release = next(
                    (
                        item
                        for item in releases
                        if re.fullmatch(spec["tag"], str(item.get("tag_name", "")))
                    ),
                    None,
                )
                if release is None:
                    fail(f"{self.name}: no release matches tag {spec['tag']}")
            else:
                release = json.loads(
                    fetch(f"https://api.github.com/repos/{repo}/releases/latest")
                )
            value = release_doc(release)
        elif "prefetch" in spec:
            ref = render(spec["prefetch"], namespace, self.hasher)
            out = subprocess.run(
                ["nix", "flake", "prefetch", "--json", ref],
                check=True,
                capture_output=True,
                text=True,
            ).stdout
            value = json.loads(out)
        else:
            data = fetch(render(spec["url"], namespace, self.hasher))
            value = json.loads(data) if spec.get("json") else data.decode()

        if "json_path" not in spec:
            return value
        return check(spec, key, str(json_path(value, spec["json_path"])), self.hasher)

    def derive_spec(self, key: str, spec: dict, namespace: dict):
        source = namespace[spec["doc"]]
        if "json_path" in spec:
            value = json_path(source, spec["json_path"])
        elif "regex" in spec:
            match = re.search(
                render(spec["regex"], namespace, self.hasher, lenient=True),
                source,
                re.MULTILINE,
            )
            if not match:
                fail(f"{self.name}: regex failed for {key}")
            value = match.group(1)
        else:
            name = render(spec["digest_of"], namespace, self.hasher)
            digest = next(
                (
                    asset.get("digest")
                    for asset in source.get("assets", [])
                    if asset.get("name") == name
                ),
                None,
            )
            if not digest:
                fail(f"{self.name}: no digest for {name}")
            if not str(digest).startswith("sha256:"):
                fail(f"{self.name}: unsupported digest for {name}: {digest}")
            value = str(digest)[len("sha256:") :]
        return check(spec, key, str(value), self.hasher)

    def process(self, path: str, namespace: dict, old: dict) -> bool:
        path = Path(path)
        text = path.read_text()
        local = dict(namespace)
        pins: dict[str, dict] = {}

        for key, spec in self.table.items():
            if key in META:
                continue
            kind = spec_kind(f"{self.name}.{key}", spec)
            if kind == "fetch":
                local[key] = self.fetch_spec(key, spec, local)
            elif kind == "derive":
                local[key] = self.derive_spec(key, spec, local)
            else:
                match = re.search(f"^{spec['pattern']}$", text, re.MULTILINE)
                if not match:
                    fail(f"{self.name}: pin pattern not found: {key}")
                value = match.group(1)
                validate = spec.get("validate")
                if validate and not re.fullmatch(validate, value):
                    fail(f"{self.name}: {key} failed validation: {value}")
                old[key] = value
                local[key] = value
                pins[key] = spec

        changed = False
        for key, spec in pins.items():
            new = render(spec["value"], local, self.hasher)
            match = re.search(f"^{spec['pattern']}$", text, re.MULTILINE)
            if new == match.group(1):
                continue
            text = text[: match.start(1)] + new + text[match.end(1) :]
            changed = True
        if changed:
            path.write_text(text)
            namespace.update(local)
        return changed


def load_rules(path: Path) -> dict:
    raw = tomllib.loads(path.read_text())
    rules = {}
    for name, table in raw.items():
        if name == "meta":
            continue
        if set(META) & set(table) == set():
            fail(f"rule {name} lacks package/packages")
        rules[name] = table
    return rules


def print_config(path: Path) -> None:
    """Emit the [meta] table as the update workflow's driving config."""
    meta = tomllib.loads(path.read_text())["meta"]
    print(
        json.dumps(
            {
                "managed": meta["managed"],
                "nix_update": {
                    pkg: str(flags).split() for pkg, flags in meta["nix-update"].items()
                },
            }
        )
    )


def main() -> None:
    args = sys.argv[1:]
    rules = load_rules(RULES_FILE)
    if "--print-config" in args:
        print_config(RULES_FILE)
        return

    hasher = Hasher()
    status = 0
    for name in args or list(rules):
        if name not in rules:
            log(f"unknown rule: {name}")
            status = 1
            continue
        try:
            rule = Rule(name, rules[name], hasher)
            namespace: dict = {}
            old: dict[str, str] = {}
            changed = [path for path in rule.files() if rule.process(path, namespace, old)]
            if not changed:
                log(f"{name}: up to date")
                continue
            subprocess.run(["git", "add", "--", *changed], check=True, cwd=ROOT)
            commit_ns = {
                **namespace,
                **{f"old.{key}": value for key, value in old.items()},
                "changed": " ".join(sorted({Path(p).parent.name for p in changed})),
            }
            message = render(rules[name]["commit"], commit_ns, hasher)
            for field, label in (("diff", "Diff"), ("changelog", "Changelog")):
                template = rules[name].get(field)
                if template:
                    message += f"\n\n{label}: {render(template, commit_ns, hasher)}"
            subprocess.run(
                [
                    "git",
                    "commit",
                    "--quiet",
                    "-m",
                    message,
                    "--",
                    *changed,
                ],
                check=True,
                cwd=ROOT,
            )
            log(f"{name}: refreshed pins ({', '.join(changed)})")
        except Exception as err:  # noqa: BLE001 - one rule must not stop the rest
            log(f"{name}: FAILED: {err}")
            status = 1
    sys.exit(status)


if __name__ == "__main__":
    main()
