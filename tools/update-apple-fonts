#!/usr/bin/env bash
# Refresh the pinned DMG hashes in packages/fonts/apple/*/package.nix.
#
# The apple font trees are vendored from Lyndeno/apple-fonts.nix, which pins
# its DMG sources as flake inputs inside its own lock (entries there carry
# narHash — a different digest than the plain sha256 of the same file).
# Vendors that keep tree on disk can mirror upstream; here the honest source
# is the Apple developer CDN itself, so pull from the digital source directly:
# each DMG is fetched and hashed individually, and packages with hash drift
# are rewritten. Commits the refresh when anything changed.
#
# Usage: tools/update-apple-fonts [package-dir ...]   (default: every apple-fonts package)
# Deps: bash, curl, sha256sum, nix, git.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
tree="$here/../packages/fonts/apple"

if [ "$#" -gt 0 ]; then
  pkgs=()
  for arg in "$@"; do
    pkgs+=("$tree/$arg/package.nix")
  done
else
  pkgs=("$tree"/*/package.nix)
fi

# points (package file) -> pinned DMG URL, verifying pins against CDN content
declare -A url_for_pkg=()
urls=()
for pkg in "${pkgs[@]}"; do
  url=$(sed -n 's#^.*url = "\(https://devimages-cdn\.apple\.com/design/resources/download/.*\.dmg\)";$#\1#p' "$pkg")
  [[ -n $url ]] || {
    echo "apple-fonts: no pinned dmg url in $(dirname "${pkg#"$here"/../}")" >&2
    exit 1
  }
  url_for_pkg[$pkg]=$url
  case " ${urls[*]:-} " in
    *" $url "*) ;;
    *) urls+=("$url") ;;
  esac
done

# fetch each DMG once: hash it straight off the wire; the pinned hash is the
# sha256 of raw file content (fetchurl semantics), not a NAR digest
declare -A sri_for_url=()
for url in "${urls[@]}"; do
  hex=$(curl -fsSL --retry 5 --retry-all-errors --connect-timeout 30 "$url" | sha256sum | cut -d' ' -f1)
  [[ $hex =~ ^[0-9a-f]{64}$ ]]
  sri_for_url[$url]=$(nix hash to-sri --type sha256 "$hex")
done

changed=()
for pkg in "${pkgs[@]}"; do
  url=${url_for_pkg[$pkg]}
  pin=$(sed -n 's#^.*hash = "\(sha256-.*\)";$#\1#p' "$pkg")
  [[ -n $pin ]] || {
    echo "apple-fonts: no pinned hash in $pkg" >&2
    exit 1
  }
  got=${sri_for_url[$url]}
  if [ "$pin" != "$got" ]; then
    sed -i "s#hash = \"$pin\";#hash = \"$got\";#" "$pkg"
    changed+=("$(basename "$(dirname "$pkg")")")
  fi
done

if [ "${#changed[@]}" -eq 0 ]; then
  echo "apple-fonts: all dmg pins up to date"
  exit 0
fi

git add -- "$tree"
if git diff --cached --quiet; then
  echo "apple-fonts: warnings unexpected (changes detected but nothing staged)" >&2
  exit 1
fi
git commit --quiet -m "apple-fonts: refresh dmg hashes (${changed[*]})"
echo "apple-fonts: refreshed pins for ${changed[*]}"
