# Deprecated overlay attributes, kept as throwing aliases so existing
# configurations get a migration hint instead of a missing-attribute error.
#
# The mapping data is intentionally one line per alias. To add a new
# compatibility alias, add an entry to the relevant table below.
{ lib }:
let
  inherit (lib)
    mapAttrs'
    nameValuePair
    ;

  renamed =
    scope: packages: attrs:
    mapAttrs' (
      old: new: nameValuePair old (throw "${scope}.${old} has been renamed to ${packages}.${new}.")
    ) attrs;
in
